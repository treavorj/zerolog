# Auto-detect text files and ensure LF line endings
* text=auto eol=lf

# Go source files
*.go text eol=lf

# Documentation
*.md text eol=lf

# Configuration files
*.mod text eol=lf
*.sum text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
